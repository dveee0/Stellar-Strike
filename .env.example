# ==========================================
# STELLAR STRIKE - ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase Project URL (Dapatkan dari Supabase Dashboard > Project Settings > API)
# Contoh: https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public API Key (Dapatkan dari Supabase Dashboard > Project Settings > API)
# Contoh: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Port Server Node.js
PORT=3001
